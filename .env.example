# Cấu hình cho trợ lý AI hướng dẫn sử dụng (api/assistant.ts).
# Sao chép file này thành ".env" và điền giá trị thật — KHÔNG commit file ".env".
# Đổi nhà cung cấp LLM chỉ bằng cách sửa 3 biến này, không cần sửa code.

# Base URL của endpoint tương thích OpenAI (không có "/chat/completions" ở cuối).
ASSISTANT_BASE_URL=

# API key của nhà cung cấp — CHỈ được đọc ở server (api/assistant.ts), không lộ ra client.
ASSISTANT_API_KEY=

# Tên model cần gọi, theo đúng định dạng nhà cung cấp yêu cầu.
ASSISTANT_MODEL=

# ---------------------------------------------------------------------------
# Preset 1 — Groq (https://console.groq.com)
#   ASSISTANT_BASE_URL=https://api.groq.com/openai/v1
#   ASSISTANT_MODEL=openai/gpt-oss-120b
#   (llama-3.3-70b-versatile đã bị Groq ngừng hỗ trợ từ 16/08/2026 — dùng
#   openai/gpt-oss-120b hoặc xem model mới nhất tại console.groq.com/docs/models)
#
# Preset 2 — Gemini (https://ai.google.dev)
#   ASSISTANT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   ASSISTANT_MODEL=gemini-3.7-flash
#   (gemini-2.5-flash vẫn dùng được nhưng đang được thay thế dần — xem model
#   mới nhất tại ai.google.dev/gemini-api/docs/models)
# ---------------------------------------------------------------------------
